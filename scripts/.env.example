SUPABASE_URL=https://tu-proyecto.supabase.co
# service_role, NO el anon key: este script necesita saltarse RLS para escribir
# en las tablas espejo. Sácalo de Settings > API > service_role secret.
# No lo compartas ni lo pegues en el chat.
SUPABASE_SERVICE_ROLE_KEY=

# Carpeta donde están los CSV exportados de World Office (solo para sembrar_wo.py)
VISTAS_EXPORT_DIR=/Users/anita/Downloads/vistas_export

# --- Conexión ODBC a World Office (solo para agente.py) ---
# servidor/puerto/base_datos/usuario son solo el fallback de la primera corrida:
# una vez el agente conecta, los guarda en la tabla wo_config y desde ahí se
# vuelven la fuente de verdad (editable después desde una futura UI de admin).
# La contraseña NUNCA se guarda en wo_config — siempre vive aquí.
WO_ODBC_DRIVER={ODBC Driver 17 for SQL Server}
WO_SERVIDOR=
WO_PUERTO=1433
WO_BASE_DATOS=
WO_USUARIO=
WO_PASSWORD=
