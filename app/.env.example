SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key
# service_role / secret key — SOLO se usa en rutas server/ (Nitro), nunca llega al bundle
# del navegador. Necesaria para RF-08 (generar credenciales de cliente).
SUPABASE_SECRET_KEY=

# RF-21: notificaciones push. Generar con `node -e "console.log(require('web-push').generateVAPIDKeys())"`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Secreto compartido con el Database Webhook de Supabase que dispara los push
# automáticos — cualquier cadena larga y aleatoria sirve.
PUSH_WEBHOOK_SECRET=
